1. First install the "bind" package into your machine
  # install bind -y  

2. Then goto the /etc/named.conf
# vim /etc/named.conf
options {
        listen-on port 53 { <DNS-server-ip>; };  # only change in these lines and leave as it is
	
	allow-transfer { <DNS-slave ip>; };
        dnssec-validation no;

}

zone "example.com" IN {                           # write your domain name in the place of example.com not fqdn
        type master;
        file "forward.zone";
        allow-update { none; };
};

zone "159.168.192.in-addr.arpa" IN {
        type master;
        file "reverse.zone";
        allow-update { none; };
};

